# ─────────────────────────────────────────────────────────────────────────────
# STEG Back Office (Angular) — Environment Variables Reference
# Copy this file to `.env` for local development.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend base URL ──────────────────────────────────────────────────────────
# Absolute URL of the Spring Boot backend API.
# Local: http://localhost:8080
# Production: https://api.steg.tn
API_BASE_URL=http://localhost:8080

# ── WebSocket base URL (optional) ─────────────────────────────────────────────
# If omitted, derived from API_BASE_URL by protocol substitution
# (http→ws, https→wss).
# WS_BASE_URL=

# ── Application Display ───────────────────────────────────────────────────────
APP_NAME=STEG Back Office
DEFAULT_LOCALE=fr

# ── Pagination Defaults ──────────────────────────────────────────────────────
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=100
